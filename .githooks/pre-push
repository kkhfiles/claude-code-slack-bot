#!/bin/sh
# 푸시 전에 검사를 다 돌린다.
#
# **푸시가 일이 이 PC 를 떠나는 순간**이라 문을 여기 세운다. 커밋마다 돌리기엔
# 37초가 길고, 안 돌리면 「어느 검사를 돌릴지」가 다시 사람 기억으로 돌아간다 —
# 그렇게 해서 검사 하나가 11일 동안 못 도는 채로 있었다(2026-08-23).
#
# 급하면 `git push --no-verify`. **빠져나갈 길을 막지 않는다** — 못 빠져나가는
# 문은 우회되고, 우회되기 시작한 문은 없는 것과 같다.
set -e
echo "── 푸시 전 검사 (건너뛰려면 git push --no-verify) ──"
if ! npm test; then
  echo ""
  echo "⛔ 검사가 막았습니다 — 고치고 다시 푸시하세요"
  exit 1
fi
