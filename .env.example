# Slack App Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Claude Code Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key

# Working Directory Configuration
# Base directory for relative paths (e.g., /Users/username/Code/)
# If set, you can use "cwd project-name" instead of full paths
BASE_DIRECTORY=/Users/username/Code/

# Default model for new conversations (alias: sonnet | opus | haiku, or full ID)
# Per-channel `-opus`/`-sonnet`/`-haiku` overrides this. `!o`/`!s`/`!h` prefix overrides per message.
# DEFAULT_MODEL=sonnet

# Runtime Routing (CLI vs Agent SDK)
# Per-call selector between `claude -p` (cli-handler) and `@anthropic-ai/claude-agent-sdk` (sdk-handler).
# Format: comma-separated scope tokens, or `all` / `1` / `true`. Category prefix matches detail
# (e.g. `analysis` token covers every `analysis:<type>` scope).
# Available scopes: interactive (main chat), briefing, calendar, analysis (or analysis:<type>).
# SLACKBOT_SDK_ENABLED=all
# SLACKBOT_FORCE_CLI=1  # emergency rollback — every call forced back to CLI

# Optional: Use third-party providers
# CLAUDE_CODE_USE_BEDROCK=1
# CLAUDE_CODE_USE_VERTEX=1

# Assistant Scheduler (optional)
# ASSISTANT_DM_CHANNEL=D0123456789
# ASSISTANT_CONFIG_DIR=/path/to/assistant/config

# Local HTTP server — work board (/board) and manual analysis trigger (bound to 127.0.0.1)
# Disabled if ASSISTANT_CONFIG_DIR is unset.
# REPORTS_SERVER_ENABLED=1   # set to 0 to disable
# REPORTS_SERVER_PORT=8765   # falls back to +1..+5 if busy

# System Memory Watchdog (Windows only, requires ASSISTANT_DM_CHANNEL)
# MEMORY_WATCHDOG_ENABLED=1           # 0 to disable (default: enabled)
# MEMORY_WATCHDOG_THRESHOLD_PCT=90    # % of system commit limit to trigger (default: 90)
# MEMORY_WATCHDOG_INTERVAL_SEC=180    # check interval in seconds (default: 3 min)
# MEMORY_WATCHDOG_AUTO_KILL_SEC=600   # auto-kill delay (default: 10 minutes)
# MEMORY_WATCHDOG_PROCESS_THRESHOLD_MB=7168  # per-process commit MB to trigger even when system is below threshold (default: 7168 = 7 GB)
# MEMORY_WATCHDOG_RUNAWAY_KILL_SEC=180 # auto-kill delay for a runaway process (default: 3 minutes)
# MEMORY_WATCHDOG_AI_REVIEW=1          # 0 to skip the AI review and use rules only
# MEMORY_WATCHDOG_AI_ACT=0             # 1 to act on the AI verdict (default: observe only — logged and shown, rules decide)

# Agent SDK version alignment (requires ASSISTANT_DM_CHANNEL) — weekly check, DM button runs scripts/sdk-update.mjs
# SDK_UPDATE_CHECK=1                  # 1 to enable (default: off)
# SDK_UPDATE_AT=09:30                 # first workday of the week, HH:MM (default: 09:30)

# Bot activity log — what each bot actually did, one JSON line per event.
# What people tell the bot in DMs or slash commands, and anything carrying a private
# text (1on1 notes, coffee-chat feedback, DMs forwarded to the owner), is recorded
# as a length only. The rest (what the bot posted in rooms, the owner's own DMs) is
# kept as text, so point this at a folder OUTSIDE any git repository and OUTSIDE any
# folder an AI coding agent works in (a broad search there can pull it into a prompt).
# Unset = nothing is recorded, and the bot says so once at startup.
# BOT_ACTIVITY_DIR=C:/Users/you/AppData/Local/bot-activity

# Scratch channel for trying out the chat bots (personality, tone, wording).
# Every chat bot answers here in addition to its own room, so you can poke them
# without touching a channel real people are in. Invite the bot to the channel
# too — the ID alone is not enough. Unset = no scratch channel (bots stay silent
# anywhere they were not explicitly given).
# A PRIVATE channel also needs the app subscribed to `message.groups`; a public
# one works with the `message.channels` subscription the bots already have.
# BOT_TEST_CHANNEL=C0123456789

# Let the chat bots talk to each other. Off by default — a bot message is
# normally dropped as "not a person speaking". Turning this on without the two
# limits below is a runaway: a mention skips the quiet-minutes and daily cap, so
# two bots mentioning each other trade replies at full speed and burn model
# quota faster than a human can type "stop". SOFT tells them to wrap up; HARD
# cuts the exchange until a person speaks again. A person can also say
# "그만" / "조용히 해" to stop it and "다시 해" to resume.
# BOT_TALK=1
# BOT_TALK_SOFT=10
# BOT_TALK_HARD=20

# Development
# DEBUG=true