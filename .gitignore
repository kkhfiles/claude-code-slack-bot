# Dependencies
node_modules/
.claude/

# Environment variables
.env
.env.local
.env.*.local
# .env 을 고치기 전에 떠 두는 백업. **이름만 다를 뿐 토큰이 그대로 들어 있다** —
# 이 저장소는 공개라 `.env` 하나만 막아 두면 백업이 그대로 올라간다.
.env.bak*
.env.backup*
.env.save*
.env.orig

# Bot local state (per-installation, not sensitive)
.working-dirs.json
.session-state.json
.schedule-config.json
.assistant-costs.json
.calendar-cache.json
.calendar-notifications.json
.calendar-muted-events.json

# Cross-session task files (may contain PII like channel IDs)
TASKS.md

# Bot runtime files
bot.pid

mcp-servers.json

# Build output
dist/
# 배포 전에 손으로 떠 두는 빌드 산출물 사본. dist/ 와 같은 성격이라 올리지 않는다.
dist.backup-*/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.nyc_output/
# 처리 중이던 대화 기록 (재시작 알림용 런타임 상태)
.inflight-sessions.json
# 한도에 막혀 밀린 요청 — 사용자가 보낸 원문이 들어간다
.rate-limit-until.json

# 모델 실험 산출물 — 결과는 work-assistant/docs/design.md 에 정리해 둔다
.bench/
.bench-run.log
